---
import '../styles/global.css'
import '../styles/journal.css'
import { isCurrentSection } from '../components/journal/content'

export interface Props {
  title: string
  description?: string
  ogImage?: string
}
const { title, description = 'Diver · Skier · Explorer · Tinkerer', ogImage } = Astro.props
const sections = [
  { href: '/blog', label: '日記', icon: '✎' },
  { href: '/dives', label: '潛水', icon: '≈' },
  { href: '/ski', label: '滑雪', icon: '△' },
  { href: '/explore', label: '探索', icon: '◎' },
]
const site = 'https://blog.blesscat.dev'
const pageTitle = title === 'Home' ? 'blesscat.dev' : `${title} · blesscat.dev`
const ogImageUrl = ogImage ? `${site}${ogImage}` : `${site}/og/index.png`
---
<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="blesscat.dev" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={`${site}${Astro.url.pathname}`} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#1c1917" />
  <link rel="canonical" href={`${site}${Astro.url.pathname}`} />
  <meta name="google-site-verification" content="3MYOA5lRPf0BHPcWa1_mVvEGsOTCNiit4HX9-SWsYU0" />
  <link rel="alternate" type="application/rss+xml" title="豬毛日記 RSS" href="/rss.xml" />
  <slot name="head" />
  <!-- Prevent dark mode flash: apply theme before first paint -->
  <script is:inline>
    try {
      if (localStorage.getItem('theme') !== 'light') {
        document.documentElement.classList.add('dark');
      }
    } catch (e) {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
</head>
<body class="bg-bg text-text min-h-screen">
  <a class="skip-link" href="#main-content">跳到主要內容</a>
  <header id="top-nav" class="top-nav-bar">
    <nav class="site-nav" aria-label="主要導覽">
      <a href="/" class="nav-logo"><img src="/zhumao-avatar.jpg" class="nav-avatar" alt="" width="32" height="32" /><span>blesscat<span class="brand-dot">.dev</span></span></a>
      <ul class="desktop-sections">
        {sections.map(({ href, label }) => <li><a href={href} class="nav-link" aria-current={isCurrentSection(Astro.url.pathname, href) ? 'page' : undefined}>{label}</a></li>)}
      </ul>
      <div class="nav-tools">
        <button id="search-toggle" aria-label="搜尋文章" class="nav-tool">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="10.8" cy="10.8" r="7.5"/><path d="m16.5 16.5 4.5 4.5"/></svg>
        </button>
        <button id="theme-toggle" aria-label="切換深色模式" class="nav-tool">
          <span id="theme-icon-moon" aria-hidden="true">◐</span>
          <span id="theme-icon-sun" aria-hidden="true" class="hidden">◑</span>
        </button>
      </div>
    </nav>
  </header>
  <main id="main-content" class="site-main" tabindex="-1">
    <slot />
  </main>
  <footer class="site-footer">
    <a href="/" class="footer-brand">blesscat.dev</a>
    <p>寫下踩過的坑，也記下沿途的風景。</p>
    <a href="/rss.xml">訂閱 RSS ↗</a>
  </footer>
  <nav class="bottom-tab-bar" aria-label="行動版主要導覽">
    <a href="/" class="tab-item" data-path="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}><span class="tab-icon" aria-hidden="true">⌂</span><span class="tab-label">首頁</span></a>
    {sections.map(({ href, label, icon }) => <a href={href} class="tab-item" data-path={href} aria-current={isCurrentSection(Astro.url.pathname, href) ? 'page' : undefined}><span class="tab-icon" aria-hidden="true">{icon}</span><span class="tab-label">{label}</span></a>)}
  </nav>

  <!-- 豬毛探頭 -->
  <button type="button" id="zhumao-peek" title="回到頂部 ↑" aria-label="回到頂部"><img src="/zhumao-avatar.jpg" alt="豬毛" class="peek-avatar" /></button>

  <!-- Pagefind search modal -->
  <div id="search-modal" class="search-modal" role="dialog" aria-modal="true" aria-label="搜尋文章" style="display:none;">
    <div class="search-backdrop"></div>
    <div class="search-panel">
      <div class="search-header">
        <input id="search-input" type="search" placeholder="搜尋文章..." autocomplete="off" />
        <button id="search-close" aria-label="關閉搜尋">✕</button>
      </div>
      <div id="search-results" class="search-results"></div>
    </div>
  </div>
  <script is:inline>
    (function() {
      var modal = document.getElementById('search-modal');
      var input = document.getElementById('search-input');
      var results = document.getElementById('search-results');
      var closeBtn = document.getElementById('search-close');
      var pagefind = null;
      var debounceTimer = null;
      var previousFocus = null;

      function openModal() {
        if (modal.style.display !== 'none') return;
        previousFocus = document.activeElement;
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        setTimeout(function() { input.focus(); }, 50);
      }

      function closeModal() {
        modal.style.display = 'none';
        document.body.style.overflow = '';
        input.value = '';
        results.innerHTML = '';
        if (previousFocus) previousFocus.focus();
      }

      document.getElementById('search-toggle').addEventListener('click', openModal);
      closeBtn.addEventListener('click', closeModal);
      modal.querySelector('.search-backdrop').addEventListener('click', closeModal);

      document.addEventListener('keydown', function(e) {
        if (e.key === 'Tab' && modal.style.display !== 'none') {
          var focusable = Array.from(modal.querySelectorAll('input, button, a[href]'));
          var first = focusable[0];
          var last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
        if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA') {
          e.preventDefault();
          openModal();
        }
        if (e.key === 'Escape' && modal.style.display !== 'none') {
          closeModal();
        }
      });

      async function loadPagefind() {
        if (!pagefind) {
          try { pagefind = await import('/pagefind/pagefind.js'); } catch(e) { return; }
        }
        return pagefind;
      }

      input.addEventListener('input', function() {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(search, 200);
      });

      async function search() {
        var q = input.value.trim();
        if (!q) { results.innerHTML = ''; return; }
        var pf = await loadPagefind();
        if (!pf) return;
        var res = await pf.search(q);
        var data = await Promise.all(res.results.slice(0, 10).map(function(r) { return r.data(); }));
        if (data.length === 0) {
          results.innerHTML = '';
          var empty = document.createElement('p');
          empty.className = 'search-empty';
          empty.textContent = '找不到「' + q + '」的結果';
          results.appendChild(empty);
          return;
        }
        results.innerHTML = data.map(function(item) {
          return '<a href="' + item.url + '" class="search-result">' +
            '<div class="search-result-title">' + item.meta.title + '</div>' +
            '<div class="search-result-excerpt">' + item.excerpt + '</div>' +
            '</a>';
        }).join('');
      }
    })();
  </script>
</body>
</html>



<script>
  // ── Dark mode toggle ──
  ;(function initTheme() {
    const html = document.documentElement
    const btn = document.getElementById('theme-toggle')
    const moon = document.getElementById('theme-icon-moon')
    const sun = document.getElementById('theme-icon-sun')
    if (!btn || !moon || !sun) return

    function applyTheme(dark: boolean) {
      html.classList.toggle('dark', dark)
      moon?.classList.toggle('hidden', dark)
      sun?.classList.toggle('hidden', !dark)
      btn?.setAttribute('aria-label', dark ? '切換淺色模式' : '切換深色模式')
      try { localStorage.setItem('theme', dark ? 'dark' : 'light') } catch {}
    }

    // Init from localStorage or system preference; default to dark
    let saved: string | null = null
    try { saved = localStorage.getItem('theme') } catch {}
    // Dark unless user explicitly chose light
    applyTheme(saved !== 'light')

    btn.addEventListener('click', () => {
      applyTheme(!html.classList.contains('dark'))
    })
  })()

  // Scroll-reveal for .reveal elements
  const revealEls = document.querySelectorAll('.reveal')
  if (revealEls.length) {
    const rio = new IntersectionObserver((entries) => {
      entries.forEach((entry, i) => {
        if (entry.isIntersecting) {
          // stagger siblings slightly
          setTimeout(() => entry.target.classList.add('revealed'), i * 60)
          rio.unobserve(entry.target)
        }
      })
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' })
    revealEls.forEach(el => rio.observe(el))
  }

  // Bottom tab bar active state
  const path = window.location.pathname
  const tabItems = document.querySelectorAll('.tab-item')
  tabItems.forEach(tab => {
    const tabPath = tab.getAttribute('data-path')
    if (tabPath === '/') {
      if (path === '/') tab.classList.add('active')
    } else if (tabPath && path.startsWith(tabPath)) {
      tab.classList.add('active')
    }
  })


  // 豬毛探頭
  function initPeekCat() {
    const cat = document.getElementById('zhumao-peek')
    if (!cat) return
    const tabBar = document.querySelector('.bottom-tab-bar')

    function onScroll() {
      if (!cat) return
      const scrolled = window.scrollY + window.innerHeight
      const total = document.documentElement.scrollHeight
      const ratio = total > 0 ? scrolled / total : 0
      if (ratio >= 0.7) {
        cat.classList.add('peeking')
        // 判斷 bottom-tab-bar 是否可見（手機）
        if (tabBar && window.getComputedStyle(tabBar).display !== 'none') {
          cat.classList.add('has-tabbar')
        } else {
          cat.classList.remove('has-tabbar')
        }
      } else {
        cat.classList.remove('peeking')
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true })
    onScroll()

    cat.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' })
    })
  }
  initPeekCat()
</script>
