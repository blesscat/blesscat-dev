---
import Layout from '../../layouts/Layout.astro'
import PageHeader from '../../components/PageHeader.astro'
import PostList from '../../components/journal/PostList.astro'
import Pagination from '../../components/journal/Pagination.astro'
import Topics from '../../components/journal/Topics.astro'
import { newestFirst, topicsFor } from '../../components/journal/content'
import { getCollection } from 'astro:content'
const allPosts = newestFirst(await getCollection('blog'))
const lastPage = Math.ceil(allPosts.length / 20)
const topics = topicsFor(allPosts).filter(topic => topic.tag !== '豬毛日記').slice(0, 8)
---
<Layout title="豬毛日記" description="AI Agent 踩坑筆記與日常紀錄，按時間與主題慢慢翻閱。">
  {lastPage > 1 && <link slot="head" rel="next" href={new URL('/blog/page/2', Astro.site)} />}
  <PageHeader title="豬毛日記" subtitle={`AI Agent 踩坑筆記，與值得記住的日常。共 ${allPosts.length} 篇。`} />
  <div class="archive-topics"><span class="eyebrow">循著主題讀</span><Topics topics={topics} /></div>
  <div class="section-heading"><h2>所有文章</h2><span class="eyebrow">NEWEST FIRST</span></div>
  <PostList posts={allPosts.slice(0, 20)} />
  <Pagination currentPage={1} lastPage={lastPage} />
</Layout>
