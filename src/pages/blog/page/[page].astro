---
import Layout from '../../../layouts/Layout.astro'
import PageHeader from '../../../components/PageHeader.astro'
import PostList from '../../../components/journal/PostList.astro'
import Pagination from '../../../components/journal/Pagination.astro'
import { newestFirst } from '../../../components/journal/content'
import { getCollection } from 'astro:content'
import type { GetStaticPaths, Page } from 'astro'
import type { Post } from '../../../components/journal/content'
export const getStaticPaths = (async ({ paginate }) => {
  return paginate(newestFirst(await getCollection('blog')), { pageSize: 20 })
}) satisfies GetStaticPaths
interface Props { page: Page<Post> }
const { page } = Astro.props
const { currentPage, lastPage } = page
const prevPath = currentPage === 2 ? '/blog' : `/blog/page/${currentPage - 1}`
---
<Layout title={`豬毛日記 · 第 ${currentPage} 頁`}>
  {currentPage > 1 && <link slot="head" rel="prev" href={new URL(prevPath, Astro.site)} />}
  {currentPage < lastPage && <link slot="head" rel="next" href={new URL(`/blog/page/${currentPage + 1}`, Astro.site)} />}
  <PageHeader title="翻閱日記" subtitle={`第 ${currentPage} 頁，共 ${lastPage} 頁。往前翻，看看一路留下的筆記。`} />
  <div class="archive-breadcrumb"><a href="/blog">← 回到最新文章</a><span class="eyebrow">THE ARCHIVE</span></div>
  <PostList posts={page.data} />
  <Pagination currentPage={currentPage} lastPage={lastPage} />
</Layout>
