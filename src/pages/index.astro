---
import Layout from '../layouts/Layout.astro'
import PostList from '../components/journal/PostList.astro'
import Topics from '../components/journal/Topics.astro'
import { newestFirst, postTitle, postUrl, topicsFor } from '../components/journal/content'
import { getCollection } from 'astro:content'
import dives from '../data/dives.json'
import ski from '../data/ski.json'

const posts = newestFirst(await getCollection('blog'))
const [featured, ...recent] = posts
const topics = topicsFor(posts).filter(topic => topic.tag !== '豬毛日記').slice(0, 7)
const maxDepth = Math.max(...dives.map(dive => dive.max_depth || 0))
---
<Layout title="Home" description="豬毛日記：AI Agent 踩坑筆記，與潛水、滑雪的沿途紀錄。" ogImage="/og/index.png">
  <section class="journal-masthead" aria-labelledby="journal-title">
    <div class="masthead-top"><span class="eyebrow">A PERSONAL JOURNAL</span><span class="masthead-note">AI · 生活 · 沿途風景</span></div>
    <h1 id="journal-title">豬毛日記<span class="masthead-mark" aria-hidden="true">＊</span></h1>
    <div class="masthead-bottom"><p>在螢幕前搗鼓，也往山海走走。<br class="mobile-break" />把值得記住的事，慢慢寫下來。</p><a href="/blog" class="text-link">所有文章 <span aria-hidden="true">↗</span></a></div>
  </section>

  {featured && <section class="cover-story" aria-labelledby="cover-title">
    <div class="cover-copy">
      <div class="eyebrow"><span class="accent-dot"></span> 最新一篇 <span class="cover-number">01 / JOURNAL</span></div>
      <div class="post-meta"><time datetime={featured.data.datetime ?? featured.data.date}>{featured.data.date}</time><span>{featured.data.tags?.slice(1, 3).join(' / ')}</span></div>
      <h2 id="cover-title"><a href={postUrl(featured)}>{postTitle(featured)}</a></h2>
      {featured.data.description && <p>{featured.data.description}</p>}
      <a class="text-link" href={postUrl(featured)}>讀這篇日記 <span aria-hidden="true">↗</span></a>
    </div>
    {featured.data.heroImage && <a href={postUrl(featured)} class="cover-image" aria-label={`閱讀：${postTitle(featured)}`}><img src={featured.data.heroImage} alt={postTitle(featured)} width="720" height="560" fetchpriority="high" /></a>}
  </section>}

  <div class="journal-columns">
    <section aria-labelledby="latest-title">
      <div class="section-heading"><h2 id="latest-title">最近寫下的</h2><span class="eyebrow">LATEST NOTES</span></div>
      <PostList posts={recent.slice(0, 5)} />
      <a class="archive-link" href="/blog">翻閱全部 {posts.length} 篇文章 <span aria-hidden="true">→</span></a>
    </section>
    <aside class="journal-sidebar">
      <section aria-labelledby="topics-title"><div class="section-heading"><h2 id="topics-title">循著主題讀</h2><span class="eyebrow">INDEX</span></div><Topics topics={topics} /></section>
      <section class="about-note"><img src="/zhumao-avatar.jpg" alt="豬毛" width="56" height="56" loading="lazy" /><span class="eyebrow">MEET THE JOURNAL</span><h2>嗨，這裡是豬毛。</h2><p>AI Agent 的踩坑筆記，和螢幕之外的探索紀錄。每篇日記，都是一次回頭看看。</p><a href="/rss.xml" class="text-link">用 RSS 慢慢追蹤 ↗</a></section>
    </aside>
  </div>

  <section class="field-notes" aria-labelledby="field-title">
    <div class="section-heading"><h2 id="field-title">螢幕之外</h2><span class="eyebrow">FIELD NOTES</span></div>
    <div class="field-grid">
      <a href="/dives"><span class="field-number">01 / OCEAN</span><h3>往海裡去 <span>↗</span></h3><p>{dives.length} 次潛水 · 最深 {maxDepth.toFixed(1)} m</p></a>
      <a href="/ski"><span class="field-number">02 / SNOW</span><h3>往雪山去 <span>↗</span></h3><p>{ski.length} 天滑雪 · 雪場與滑行紀錄</p></a>
      <a href="/explore"><span class="field-number">03 / ELSEWHERE</span><h3>把足跡攤開 <span>↗</span></h3><p>在地圖上，看看走過的地方</p></a>
    </div>
  </section>
</Layout>
